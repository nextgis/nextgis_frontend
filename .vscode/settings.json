{
  "editor.formatOnSave": false,
  "tslint.enable": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "git.ignoreLimitWarning": true,
  "markdownlint.config": {
    "default": true,
    "MD033": {
      "allowed_elements": [
        "summary",
        "details"
      ]
    }
  }
}
