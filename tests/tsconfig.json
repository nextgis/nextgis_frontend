{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": [
    "specs/**/*.ts",
    "internet-specs/**/*.ts",
    "helpers/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
