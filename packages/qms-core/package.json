{
  "name": "@nextgis/qms-core",
  "version": "4.0.0-rc.1",
  "description": "NextGIS QMS client for TMS and WMS services",
  "main": "index.js",
  "module": "lib/qms-core.esm-bundler.js",
  "unpkg": "lib/qms-core.global.prod.js",
  "jsdelivr": "lib/qms-core.global.prod.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@nextgis/build-tools": "4.0.0-rc.1",
    "ini": "^6.0.0"
  },
  "buildOptions": {
    "name": "QmsCore",
    "prebuild": "npm run catalog:update",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "scripts": {
    "catalog:update": "node ./scripts/update-catalog.mjs",
    "clean": "rimraf ./lib",
    "dev": "node ../build-tools/lib/build.js",
    "prod": "npm run dev -- --release",
    "lint": "eslint ./src/**/*.ts --fix -c ../../eslint.config.js",
    "watch": "npm run dev -- --watch"
  },
  "keywords": [
    "NextGIS",
    "QMS",
    "MAP"
  ],
  "author": "NextGIS",
  "files": [
    "index.js",
    "lib"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nextgis/nextgis_frontend/tree/master/packages/qms-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextgis/nextgis_frontend.git"
  },
  "bugs": {
    "url": "https://github.com/nextgis/nextgis_frontend/issues"
  }
}
