{
  "name": "@nextgis/ol-control-container",
  "version": "4.0.0-rc.1",
  "description": "OpenLayers integration for NextGIS control container",
  "main": "lib/ol-control-container.global.prod.js",
  "module": "lib/ol-control-container.esm-bundler.js",
  "unpkg": "lib/ol-control-container.global.prod.js",
  "jsdelivr": "lib/ol-control-container.global.prod.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "@nextgis/control-container": "4.0.0-rc.1"
  },
  "peerDependencies": {
    "ol": ">=6.0.0"
  },
  "devDependencies": {
    "@nextgis/build-tools": "4.0.0-rc.1",
    "ol": "^10.10.0"
  },
  "buildOptions": {
    "name": "OlControlContainer",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
