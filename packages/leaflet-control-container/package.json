{
  "name": "@nextgis/leaflet-control-container",
  "version": "4.0.0-rc.0",
  "description": "Leaflet integration for NextGIS control container",
  "main": "lib/leaflet-control-container.global.prod.js",
  "module": "lib/leaflet-control-container.esm-bundler.js",
  "unpkg": "lib/leaflet-control-container.global.prod.js",
  "jsdelivr": "lib/leaflet-control-container.global.prod.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "@nextgis/control-container": "4.0.0-rc.0"
  },
  "peerDependencies": {
    "leaflet": ">=1.5.0"
  },
  "devDependencies": {
    "@nextgis/build-tools": "4.0.0-rc.0",
    "@types/leaflet": "^1.7.5",
    "leaflet": "1.7.1"
  },
  "buildOptions": {
    "name": "LeafletControlContainer",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
