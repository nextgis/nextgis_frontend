{
  "name": "@nextgis-example/demo-vector-popup",
  "private": true,
  "displayName": "Vector layer popup",
  "description": "This example demonstrates how to create customized popups for vector layers with detailed feature information and popup behavior description. Each popup shows whether it closes on a second click or an outside click based on layer options.",
  "tags": [
    "popup",
    "vector layer",
    "behavior",
    "close",
    "select"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/utils": "*",
    "@nextgis/webmap": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@types/geojson": "^7946.0.16",
    "vite": "^6.3.5"
  }
}
