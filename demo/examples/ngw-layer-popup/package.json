{
  "name": "@nextgis-example/demo-ngw-layer-popup",
  "private": true,
  "displayName": "NGW Layer Popup on Select",
  "description": "This example demonstrates how to display a popup with detailed information about features when selecting elements on a raster layer from NextGIS Web. The popup shows attribute values for the selected features, allowing users to interact with the data.",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-maplibre-gl",
    "ngw-ol"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "build": "yarn run -T example:build",
    "build:leaflet": "yarn run -T example:build --adapter=ngw-leaflet",
    "build:maplibre-gl": "yarn run -T example:build --adapter=ngw-maplibre-gl",
    "build:ol": "yarn run -T example:build --adapter=ngw-ol"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
