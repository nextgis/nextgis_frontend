{
  "name": "@nextgis-example/demo-ngw-layer-filtering",
  "private": true,
  "displayName": "NGW Layer Filtering with Sorting",
  "description": "Filter and sort NGW layers based on feature properties. Allows users to apply filters, limit results, and sort features by selected fields in ascending or descending order.",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/properties-filter": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
