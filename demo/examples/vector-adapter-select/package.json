{
  "name": "@nextgis-example/demo-vector-adapter-select",
  "private": true,
  "displayName": "Multi-feature selection on vector layer",
  "description": "This example demonstrates how to select multiple features in a vector layer using adapter methods. By holding down the CTRL key while clicking, users can add new features to their selection, which are highlighted in red.",
  "tags": [
    "vector",
    "feature selection",
    "multiselect",
    "control",
    "adapter"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
