{
  "name": "@nextgis-example/demo-vector-label",
  "private": true,
  "displayName": "Vector label",
  "description": "Display labels for vector layer features using a specified attribute field (e.g., NAME). Labels are non-interactive and provide an easy way to visualize feature data.",
  "tags": [
    "label",
    "tooltip",
    "vector",
    "feature",
    "attribute"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
