{
  "name": "@nextgis-example/demo-vector-filtering",
  "private": true,
  "displayName": "Filter vector layer by attribute",
  "description": "Filter features of a vector layer based on a selected attribute value using a dropdown control.",
  "tags": [
    "filter",
    "vector",
    "layer",
    "attributes",
    "dropdown",
    "NGW"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/webmap": "*",
    "@types/geojson": "^7946.0.16"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
