{
  "name": "@nextgis-example/demo-geojson-data",
  "private": true,
  "displayName": "Set vector layer data",
  "description": "Click the +  button in the input on the right side of the screen to add new point in vector layer on map. Press - button to remove point from layer.",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@types/geojson": "^7946.0.16",
    "vite": "^6.3.5"
  }
}
