{
  "name": "@nextgis-example/demo-ngw-layer-properties-filters",
  "private": true,
  "displayName": "NGW layer properties filter",
  "description": "Create an NGW layer with different adapters and update its properties filter from custom controls.",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/properties-filter": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
