{
  "name": "@nextgis-example/demo-webmap-identification",
  "private": true,
  "displayName": "WebMap feature highlighting",
  "description": "This example demonstrates how to highlight the first feature from a web map layer upon clicking. Each new click removes the current highlight and stops any pending identification requests to ensure a seamless experience.",
  "tags": [
    "highlight",
    "feature",
    "click",
    "identify",
    "geojson"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
