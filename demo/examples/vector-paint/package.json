{
  "name": "@nextgis-example/demo-vector-paint",
  "private": true,
  "displayName": "Vector paint styles",
  "description": "Apply different paint styles to vector layers based on their properties. This example shows how to dynamically style points, lines, and polygons using color, opacity, and other visual properties.",
  "tags": [
    "vector",
    "paint",
    "style",
    "geometry",
    "properties"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl",
    "build": "yarn run -T example:build",
    "build:leaflet": "yarn run -T example:build --adapter=ngw-leaflet",
    "build:ol": "yarn run -T example:build --adapter=ngw-ol",
    "build:maplibre-gl": "yarn run -T example:build --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/paint": "*",
    "@nextgis/webmap": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@types/geojson": "^7946.0.16",
    "vite": "^6.3.5"
  }
}
