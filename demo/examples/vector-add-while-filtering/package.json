{
  "name": "@nextgis-example/demo-vector-add-while-filtering",
  "private": true,
  "displayName": "Vector layer filter and add",
  "description": "Filter points on a vector layer by color and add new points using buttons. Points that don't match the filter will not appear.",
  "tags": [
    "vector",
    "filter",
    "add data",
    "geojson",
    "interactive",
    "color"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl",
    "build": "yarn run -T example:build",
    "build:leaflet": "yarn run -T example:build --adapter=ngw-leaflet",
    "build:ol": "yarn run -T example:build --adapter=ngw-ol",
    "build:maplibre-gl": "yarn run -T example:build --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@nextgis/webmap": "*",
    "@types/geojson": "^7946.0.16",
    "vite": "^6.3.5"
  }
}
