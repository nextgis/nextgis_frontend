{
  "name": "@nextgis-example/demo-control-panel",
  "private": true,
  "displayName": "Control panel with nested controls",
  "description": "Visual control layout test with default controls, standalone controls, a text bar, and nested panels in every map corner.",
  "tags": [
    "control",
    "control panel",
    "button",
    "toggle",
    "order"
  ],
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl",
    "build": "yarn run -T example:build",
    "build:leaflet": "yarn run -T example:build --adapter=ngw-leaflet",
    "build:ol": "yarn run -T example:build --adapter=ngw-ol",
    "build:maplibre-gl": "yarn run -T example:build --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/control-container": "*",
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@nextgis/webmap": "*",
    "vite": "^6.3.5"
  }
}
