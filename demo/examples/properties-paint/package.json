{
  "name": "@nextgis-example/demo-properties-paint",
  "private": true,
  "displayName": "Properties paint",
  "description": "Use properties filter to set paint",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
