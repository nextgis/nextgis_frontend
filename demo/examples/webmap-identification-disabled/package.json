{
  "name": "@nextgis-example/demo-webmap-identification-disabled",
  "private": true,
  "displayName": "Web Map Layer-Specific Feature Identification",
  "description": "The polygon frame displayed above all other layers is not identified because identification is disabled for this Web Map layer item.",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
