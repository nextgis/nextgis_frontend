{
  "name": "@nextgis-example/demo-ip-cameras-map",
  "private": true,
  "displayName": "IP cameras map",
  "description": "Display the stream from the ip camera in the location",
  "ngwMaps": [
    "ngw-leaflet",
    "ngw-ol",
    "ngw-maplibre-gl"
  ],
  "onlyForDemo": false,
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/ngw-leaflet": "*",
    "@nextgis/utils": "*"
  },
  "devDependencies": {
    "@nextgis/ngw-maplibre-gl": "*",
    "@nextgis/ngw-ol": "*",
    "@types/geojson": "^7946.0.16",
    "vite": "^6.3.5"
  }
}
