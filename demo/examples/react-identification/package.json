{
  "name": "@nextgis-example/demo-react-identification",
  "private": true,
  "displayName": "React feature identification",
  "description": "Identify features and highlight them with a reactive GeoJSON layer.",
  "skipDemo": true,
  "ngwMaps": [
    "react-ngw-leaflet",
    "react-ngw-ol",
    "react-ngw-maplibre-gl"
  ],
  "scripts": {
    "start": "yarn run start:leaflet",
    "start:leaflet": "yarn run -T example --adapter=react-ngw-leaflet",
    "start:ol": "yarn run -T example --adapter=react-ngw-ol",
    "start:maplibre-gl": "yarn run -T example --adapter=react-ngw-maplibre-gl",
    "build": "yarn run -T example:build",
    "build:leaflet": "yarn run -T example:build --adapter=react-ngw-leaflet",
    "build:ol": "yarn run -T example:build --adapter=react-ngw-ol",
    "build:maplibre-gl": "yarn run -T example:build --adapter=react-ngw-maplibre-gl"
  },
  "dependencies": {
    "@nextgis/react-ngw-leaflet": "*",
    "@nextgis/react-ngw-map": "*",
    "@nextgis/paint": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@nextgis/ngw-kit": "*",
    "@nextgis/react-ngw-maplibre-gl": "*",
    "@nextgis/react-ngw-ol": "*",
    "vite": "^6.3.5"
  }
}
